# CampusOS AI — Environment Configuration
# Copy this file to .env.local and fill in your values.
#
# ALL features below work WITHOUT any external service configured.
# The app falls back to local heuristics / console-logged emails / demo Pro activation.
# Add keys below ONLY when you're ready to use real services.

# =====================================================
# AI PROVIDERS (at least one optional — "demo" works without keys)
# =====================================================
# Get OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get Anthropic key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Which provider to prefer: "openai" | "anthropic" | "demo"
# "demo" uses smart heuristics (no key needed, great for offline demos)
AI_PROVIDER=demo

# =====================================================
# AUTHENTICATION (REQUIRED — change in production!)
# =====================================================
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-random-32-byte-secret-for-jwt-tokens-min

# =====================================================
# DATABASE (REQUIRED)
# =====================================================
# Local dev (zero setup):     DATABASE_URL="file:./dev.db"
# Production Postgres:        DATABASE_URL="postgresql://user:pass@host:5432/campusos"
# Then change `provider` in prisma/schema.prisma from "sqlite" → "postgresql"
DATABASE_URL="file:./dev.db"

# =====================================================
# PAYMENTS — Razorpay (OPTIONAL — demo mode works without keys)
# =====================================================
# Get keys: https://dashboard.razorpay.com/app/keys
# Test mode keys start with rzp_test_ — safe for development
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook (for production server-side verification)
# Dashboard → Settings → Webhooks → New Webhook
# URL:  https://your-domain.com/api/payments/webhook
# Events: payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# =====================================================
# EMAIL — Resend (OPTIONAL — emails log to console without key)
# =====================================================
# Sign up free (100 emails/day): https://resend.com
RESEND_API_KEY=
EMAIL_FROM=CampusOS AI <noreply@yourdomain.com>

# =====================================================
# APP CONFIG
# =====================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=CampusOS AI